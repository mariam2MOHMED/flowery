# 🌍 Base URL
API_URL=https://flower.elevateegy.com/api/v1/

# 📦 Products
PRODUCTS_ENDPOINT=products
PRODUCTS_BY_OCCASION_ENDPOINT=products?

# 🔐 Auth
AUTH_ENDPOINT=auth/
LOGIN_ENDPOINT=signin
SIGNUP_ENDPOINT=signup/
FORGET_PASSWORD_ENDPOINT=forgotPassword
VERIFY_PASSWORD_ENDPOINT=verifyResetCode
